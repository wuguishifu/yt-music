{
  "name": "apollo-kore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apollo-kore/src",
  "projectType": "library",
  "// targets": "to see all targets run: nx show project apollo-kore --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["apollo"], "target": "typecheck" }],
      "options": {
        "cwd": "libs/apollo-kore",
        "command": "node ./scripts/build.mjs"
      }
    },
    "typecheck": {
      "dependsOn": ["build"]
    }
  }
}
